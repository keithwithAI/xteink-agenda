# xteink-agenda server configuration
# Copy to .env and fill in. Never commit .env.

# Path to your Google service-account JSON (relative to project root).
# Create one in Google Cloud Console, enable the Calendar API, and share your
# calendars with the service account's email address.
GCAL_SERVICE_ACCOUNT=service-account.json

# Calendar views — the X4 cycles through these with the Back button.
# Format: Name:calendar_id1,calendar_id2
VIEW_0=All:you@example.com
#VIEW_1=Work:you@company.com

# Waking-hours window for the on-device day-progress bar (24h clock).
DAY_START=7
DAY_END=23

# IANA timezone (leave blank to use the system timezone).
#TZ=Europe/London

# Optional: pushed to the device on boot via /api/x4/config.
# Leave blank to keep whatever is flashed in the firmware's secrets.h.
#DEVICE_WIFI_SSID=
#DEVICE_WIFI_PASS=
#DEVICE_SERVER_HOST=
#DEVICE_SERVER_PORT=8080

# Server port (default 8080)
#PORT=8080
